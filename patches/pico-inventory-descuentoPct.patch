+
+// % de descuento por producto para la tienda (0 = sin oferta)
+function parseDescuentoPct(raw){
+  if(raw===''||raw==null) return 0;
+  const n=parseFloat(raw);
+  if(isNaN(n)||n<0) return NaN;
+  return Math.min(100, Math.round(n));
+}
+function applyDescuentoPctToData(data, pct){
+  if(pct>0) data.descuentoPct=pct;
+  else data.descuentoPct=firebase.firestore.FieldValue.delete();
+}
