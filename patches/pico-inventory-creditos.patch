+async function grantCredits(){
+  const err=document.getElementById('cred-form-error');
+  const email=(document.getElementById('cred-email').value||'').trim().toLowerCase();
+  const monto=parseFloat(document.getElementById('cred-monto').value);
+  const diasRaw=document.getElementById('cred-dias').value;
+  const dias=diasRaw===''?0:parseInt(diasRaw,10);
+  const proyecto=(document.getElementById('cred-proyecto').value||'').trim();
+  const integrantes=(document.getElementById('cred-integrantes').value||'').trim();
+  const nota=(document.getElementById('cred-nota').value||'').trim();
+  if(!email||email.indexOf('@')<0){err.textContent='Correo inválido.';return;}
+  if(!(monto>0)){err.textContent='Monto inválido.';return;}
+  if(isNaN(dias)||dias<0){err.textContent='Días de caducidad inválidos.';return;}
+  err.textContent='';
+  const ref=db.collection('creditos').doc(email);
+  try{
+    await db.runTransaction(async tx=>{
+      const snap=await tx.get(ref);
+      const now=Date.now();
+      const venceAt=dias>0?(now+dias*86400000):null;
+      const proj=proyecto?{nombre:proyecto,integrantes:integrantes?integrantes.split(',').map(s=>s.trim()).filter(Boolean):[],nota:nota||null}:null;
+      if(!snap.exists){
+        tx.set(ref,{email,emailLower:email,saldo:+monto.toFixed(2),totalOtorgado:+monto.toFixed(2),totalUsado:0,costoInvertido:0,venceAt,proyecto:proj,movimientos:[{tipo:'grant',monto:+monto.toFixed(2),at:now,by:(auth.currentUser&&auth.currentUser.email)||'admin',nota:nota||proyecto||null}],createdAt:now,updatedAt:now});
+      } else {
+        const d=snap.data();
+        const mov=Array.isArray(d.movimientos)?d.movimientos.slice(-39):[];
+        mov.push({tipo:'grant',monto:+monto.toFixed(2),at:now,by:(auth.currentUser&&auth.currentUser.email)||'admin',nota:nota||proyecto||null});
+        const patch={saldo:+((Number(d.saldo)||0)+monto).toFixed(2),totalOtorgado:+((Number(d.totalOtorgado)||0)+monto).toFixed(2),movimientos:mov,updatedAt:now};
+        if(venceAt) patch.venceAt=venceAt;
+        if(proj) patch.proyecto=proj;
+        if(!d.email) patch.email=email;
+        if(!d.emailLower) patch.emailLower=email;
+        tx.update(ref, patch);
+      }
+    });
+    ['cred-email','cred-monto','cred-dias','cred-proyecto','cred-integrantes','cred-nota'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
+    showToast('Créditos otorgados a '+email,'ti-coin');
+  }catch(e){console.error(e);err.textContent='Error al guardar: '+(e.message||e);}
+}
